{
  "name": "pliage-desktop",
  "productName": "Pliage",
  "version": "1.0.0",
  "description": "Pliage – boîte à outils PDF et fichiers",
  "author": "Pliage",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-www": "node copy-www.mjs",
    "start": "node copy-www.mjs && electron .",
    "dist": "node copy-www.mjs && electron-builder --win nsis portable --publish never",
    "dist:mac": "node copy-www.mjs && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.pliage.desktop",
    "productName": "Pliage",
    "copyright": "Pliage",
    "files": [
      "main.js",
      "preload.js",
      "online.js",
      "www/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pliage",
      "artifactName": "Pliage-installation-${version}.exe"
    },
    "portable": {
      "artifactName": "Pliage-portable-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF",
        "role": "Editor"
      },
      {
        "ext": "epub",
        "name": "EPUB",
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Pliage-${version}-${arch}.dmg",
      "title": "Pliage"
    }
  }
}