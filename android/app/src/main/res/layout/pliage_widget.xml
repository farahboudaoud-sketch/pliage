<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_logo"
            android:layout_width="21dp"
            android:layout_height="16dp"
            android:contentDescription="Pliage"
            android:src="@drawable/ic_w_bird"
            android:tint="@color/w_bird" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Pliage"
            android:textColor="@color/w_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_resume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/w_badge"
            android:layout_width="30dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_badge"
            android:gravity="center"
            android:text="PDF"
            android:textColor="@color/w_badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_resume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reprendre"
                android:textColor="@color/w_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_resume_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="Ouvrir un fichier"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/w_c0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_i0"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_icon_bg"
                android:contentDescription="Raccourci"
                android:padding="9dp"
                android:src="@drawable/ic_w_outils"
                android:tint="@color/w_icon" />

            <TextView
                android:id="@+id/w_t0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Outils"
                android:textColor="@color/w_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_c1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_i1"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_icon_bg"
                android:contentDescription="Raccourci"
                android:padding="9dp"
                android:src="@drawable/ic_w_outils"
                android:tint="@color/w_icon" />

            <TextView
                android:id="@+id/w_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Outils"
                android:textColor="@color/w_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_c2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_i2"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_icon_bg"
                android:contentDescription="Raccourci"
                android:padding="9dp"
                android:src="@drawable/ic_w_outils"
                android:tint="@color/w_icon" />

            <TextView
                android:id="@+id/w_t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Outils"
                android:textColor="@color/w_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_c3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_i3"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_icon_bg"
                android:contentDescription="Raccourci"
                android:padding="9dp"
                android:src="@drawable/ic_w_outils"
                android:tint="@color/w_icon" />

            <TextView
                android:id="@+id/w_t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="Outils"
                android:textColor="@color/w_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
